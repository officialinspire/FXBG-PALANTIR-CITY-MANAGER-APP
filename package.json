{
  "name": "fxbg-palantir-city-manager",
  "version": "1.0.0",
  "description": "Real-time situational awareness dashboard for Fredericksburg, VA metro area",
  "main": "proxy-server.js",
  "scripts": {
    "start": "node proxy-server.js",
    "dev": "PORT=8000 node proxy-server.js",
    "doctor": "node scripts/doctor.js",
    "install-env": "bash scripts/install-env.sh",
    "qa": "node scripts/qa-runner.js",
    "qa:suite": "node scripts/qa-suite.js",
    "smoke": "bash scripts/smoke.sh",
    "smoke:mobile": "bash scripts/smoke-mobile.sh",
    "smoke:va511:cams": "node scripts/smoke-va511-cams.js",
    "build:schools": "node scripts/build-schools-nces.js",
    "audit:schools": "node scripts/audit-schools.js",
    "env:where": "node -e \"const fs=require('fs');const p=require('path');const crypto=require('crypto');const f=p.join(__dirname,'.env');console.log('ENV_PATH=',f);if(fs.existsSync(f)){const s=fs.statSync(f);const c=fs.readFileSync(f);const h=crypto.createHash('sha256').update(c).digest('hex').slice(0,8);console.log('mtime=',s.mtime.toISOString(),'size=',s.size,'sha256='+h+'...');}else{console.log('MISSING');}\"",
    "env:status": "node -e \"fetch('http://127.0.0.1:8000/api/env/status').then(r=>r.json()).then(console.log).catch(e=>{console.error('start server first');process.exit(1);})\"",
    "build:school-overrides": "node scripts/build-school-overrides.js",
    "audit:place-precision": "node scripts/audit-place-precision.js",
    "smoke:local": "node scripts/smoke-local.js",
    "gis:prefetch:core": "node scripts/prefetch-gis-pack.js core",
    "gis:prefetch:field": "node scripts/prefetch-gis-pack.js field",
    "termux:setup": "bash scripts/termux-setup.sh",
    "termux": "bash scripts/termux-run.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fredericksburg",
    "virginia",
    "dashboard",
    "situational-awareness",
    "traffic",
    "crime-reports"
  ],
  "license": "MIT"
}
